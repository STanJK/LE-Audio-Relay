<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>

    <AssemblyName>LEAudioRouter</AssemblyName>
    <RootNamespace>LEAudioRouter</RootNamespace>

    <!-- V0.20: first stabilized Tray form. -->
    <Version>0.20.0</Version>
    <AssemblyVersion>0.20.0.0</AssemblyVersion>
    <FileVersion>0.20.0.0</FileVersion>
    <InformationalVersion>V0.20</InformationalVersion>
    <Product>LE Audio Router</Product>
    <Description>Windows LE Audio routing shell and supervised route host.</Description>

    <!--
      Round4 is a clean rewrite. Disable the SDK's recursive **/*.cs glob so
      frozen Legacy source (and Legacy build artifacts) can never enter the
      canonical application build graph accidentally.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Host\**\*.cs" />
    <Compile Include="Shell\**\*.cs" />
    <Compile Include="Settings\**\*.cs" />
    <Compile Include="Supervision\**\*.cs" />
    <Compile Include="Cli\**\*.cs" />
  </ItemGroup>

</Project>
