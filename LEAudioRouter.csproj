<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>

    <AssemblyName>LEAudioRouter</AssemblyName>
    <RootNamespace>LEAudioRouter</RootNamespace>

    <!-- V0.20.2: first event-driven endpoint lifecycle release. -->
    <Version>0.20.2</Version>
    <AssemblyVersion>0.20.2.0</AssemblyVersion>
    <FileVersion>0.20.2.0</FileVersion>
    <InformationalVersion>V0.20.2</InformationalVersion>
    <Product>LE Audio Router</Product>
    <Description>Windows LE Audio routing shell and supervised route host.</Description>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Host\**\*.cs" />
    <Compile Include="Shell\**\*.cs" />
    <Compile Include="Settings\**\*.cs" />
    <Compile Include="Supervision\**\*.cs" />
    <Compile Include="Lifecycle\**\*.cs" />
    <Compile Include="Routing\**\*.cs" />
    <Compile Include="Timing\**\*.cs" />
    <Compile Include="Telemetry\**\*.cs" />
    <Compile Include="Cli\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.0.1" />
  </ItemGroup>

</Project>
